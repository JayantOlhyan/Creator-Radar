# CreatorRadar Environment Configuration

# Application Environment
APP_NAME=CreatorRadar
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=true

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000

# Database Configuration (PostgreSQL)
POSTGRES_USER=creatorradar
POSTGRES_PASSWORD=creatorradar_dev_pass
POSTGRES_DB=creatorradar_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://creatorradar:creatorradar_dev_pass@postgres:5432/creatorradar_db

# Redis Configuration (Queue & Caching)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Source Acquisition Configuration
# Option A: Official Meta Instagram Graph API (Business Discovery)
INSTAGRAM_GRAPH_ACCESS_TOKEN=your_instagram_graph_access_token_here
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id_here

# Option B: Compliant External Proxy Provider
EXTERNAL_ACQUISITION_API_KEY=your_external_acquisition_api_key_here
EXTERNAL_ACQUISITION_ENDPOINT=https://api.external-social-provider.com/v1

# Polling & Rate Limiting Settings
CREATOR_CHECK_INTERVAL_MINUTES=60
SOURCE_RATE_LIMIT_PER_MINUTE=60
MAX_CONCURRENT_SOURCE_REQUESTS=5

# AI Provider Configuration
# Supported providers: openai, gemini, anthropic, local, mock
AI_PROVIDER=mock
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LOCAL_AI_ENDPOINT=http://localhost:11434

# Notification Delivery Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
